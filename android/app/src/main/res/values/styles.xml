<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Light theme only in draft 1. The black window background stops a white
         flash on cold start before the splash screen draws. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <!-- Gray navigation buttons: the bottom tab bar and sheets are white. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

</resources>
